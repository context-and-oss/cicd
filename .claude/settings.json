{
  "permissions": {
    "deny": [
      "Read(**/internal/dagger/**)",
      "Read(**/internal/querybuilder/**)",
      "Read(**/internal/telemetry/**)",
      "Read(**/dagger.gen.go)",
      "Read(**/.dagger/**)",
      "Read(**/.dagger-query-state/**)",
      "Read(**/node_modules/**)",
      "Read(out/**)",
      "Read(smoke-out/**)",
      "Read(smoke-evidence*/**)",

      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.crt)",
      "Read(**/*.pfx)",
      "Read(**/*.p12)",
      "Read(**/*.gpg)",
      "Read(**/*.asc)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/id_ecdsa*)",
      "Read(**/.npmrc)",
      "Read(**/.netrc)",
      "Read(**/.pypirc)",
      "Read(**/.aws/**)",
      "Read(**/.gcloud/**)",
      "Read(**/.gcp/**)",
      "Read(**/.azure/**)",
      "Read(**/.docker/config.json)",
      "Read(**/.kube/config)",
      "Read(**/kubeconfig)",
      "Read(**/*.kubeconfig)",
      "Read(**/credentials)",
      "Read(**/credentials.json)",
      "Read(**/secrets.yaml)",
      "Read(**/secrets.yml)",
      "Read(**/secrets.json)",
      "Bash(cat **/.env*)",
      "Bash(cat **/*.pem)",
      "Bash(cat **/*.key)",
      "Bash(cat **/id_rsa*)",
      "Bash(cat **/credentials*)"
    ]
  }
