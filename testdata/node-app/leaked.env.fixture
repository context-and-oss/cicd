# FAKE credential — secrets-scanner integration test fixture only, not a real key.
# Unlike secrets.js / go-app's secrets.go (which use gitleaks:allow and AWS's
# allowlisted ...EXAMPLE key), this key is deliberately detectable: build.mjs
# copies this file to dist/leaked.env so archive-scan tests get a deterministic
# finding from the default gitleaks rule "aws-access-token".
AWS_ACCESS_KEY_ID=AKIAPLANTEDFAKE4CICD
